<Window x:Class="calc.src.main.views.MainWindow"
        xmlns:local="clr-namespace:calc.src.main.views"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Калькулятор" Height="600" Width="450" 
        MinWidth="350" MinHeight="500"
        Background="{DynamicResource WindowBg}">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="120"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Button Content="Обычный" Click="BtnModeNormal_Click"
            Height="25" Width="100" FontSize="15" 
            Style="{StaticResource GhostButtonStyle}"/>
            <Button Content="Инженереный" Click="BtnModeEng_Click"
            Height="25" Width="100" FontSize="15"
         Style="{StaticResource GhostButtonStyle}"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="История" Click="BtnHistory_Click" 
            Background="Transparent" BorderThickness="0" 
            Foreground="Gray" Cursor="Hand" Margin="0,0,10,0"/>
            <Button Content="Очистить историю" Click="BtnClearHistory_Click" 
            Background="Transparent" BorderThickness="0" 
            Foreground="Gray" Cursor="Hand" ToolTip="Очистить историю"/>
        </StackPanel>

        <TextBox Grid.Row="1" x:Name="TxtDisplay" Text="0" TextAlignment="Right" 
                 FontSize="48" FontWeight="Bold" Background="Transparent" 
                 VerticalAlignment="Center" BorderThickness="0" IsReadOnly="True" 
                 Foreground="{DynamicResource AccentColor}"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColEng" Width="0"/>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <UniformGrid x:Name="GridEng" Columns="2" Margin="0,0,5,0">
                <Button Content="x²" Style="{StaticResource GhostButtonStyle}" Click="BtnEng_Click"/>
                <Button Content="√" Style="{StaticResource GhostButtonStyle}" Click="BtnEng_Click"/>
                <Button Content="sin" Style="{StaticResource GhostButtonStyle}" Click="BtnEng_Click"/>
                <Button Content="cos" Style="{StaticResource GhostButtonStyle}" Click="BtnEng_Click"/>
                <Button Content="tg" Style="{StaticResource GhostButtonStyle}" Click="BtnEng_Click"/>
                <Button Content="^" Style="{StaticResource GhostButtonStyle}" Click="BtnOperation_Click"/>
                <Button Content="%" Style="{StaticResource GhostButtonStyle}" Click="BtnPercent_Click"/>
                <Button Content="обр." Style="{StaticResource GhostButtonStyle}" Click="BtnEng_Click"/>
            </UniformGrid>

            <UniformGrid Grid.Column="1" Columns="3">
                <Button Content="7" Style="{StaticResource GhostButtonStyle}" Click="BtnDigit_Click"/>
                <Button Content="8" Style="{StaticResource GhostButtonStyle}" Click="BtnDigit_Click"/>
                <Button Content="9" Style="{StaticResource GhostButtonStyle}" Click="BtnDigit_Click"/>
                <Button Content="4" Style="{StaticResource GhostButtonStyle}" Click="BtnDigit_Click"/>
                <Button Content="5" Style="{StaticResource GhostButtonStyle}" Click="BtnDigit_Click"/>
                <Button Content="6" Style="{StaticResource GhostButtonStyle}" Click="BtnDigit_Click"/>
                <Button Content="1" Style="{StaticResource GhostButtonStyle}" Click="BtnDigit_Click"/>
                <Button Content="2" Style="{StaticResource GhostButtonStyle}" Click="BtnDigit_Click"/>
                <Button Content="3" Style="{StaticResource GhostButtonStyle}" Click="BtnDigit_Click"/>
                <Button Content="," Style="{StaticResource GhostButtonStyle}" Click="BtnDigit_Click"/>
                <Button Content="0" Style="{StaticResource GhostButtonStyle}" Click="BtnDigit_Click"/>
                <Button Content="⌫" Style="{StaticResource GhostButtonStyle}" Click="BtnBackspace_Click"/>
            </UniformGrid>

            <UniformGrid Grid.Column="2" Columns="1" Margin="5,0,0,0">
                <Button Content="C" Style="{StaticResource GhostButtonStyle}" Foreground="OrangeRed" Click="BtnClear_Click"/>
                <Button Content="÷" Style="{StaticResource GhostButtonStyle}" Click="BtnOperation_Click"/>
                <Button Content="×" Style="{StaticResource GhostButtonStyle}" Click="BtnOperation_Click"/>
                <Button Content="-" Style="{StaticResource GhostButtonStyle}" Click="BtnOperation_Click"/>
                <Button Content="+" Style="{StaticResource GhostButtonStyle}" Click="BtnOperation_Click"/>
                <Button Content="=" Style="{StaticResource MainButtonStyle}" Click="BtnEqual_Click"/>
            </UniformGrid>
        </Grid>
    </Grid>
</Window>